  "item": [
    {
      "name": "TC-USR-01: Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Create User Content\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"User created\");",
              "    pm.expect(jsonData.user.is_active).to.eql(true);",
              "    pm.environment.set(\"active_user_id\", jsonData.user.user_id);",
              "    pm.environment.set(\"active_user_email\", jsonData.user.email);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "default"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Alice Smith\",\n    \"email\": \"alice.smith@example.com\"\n}"
        },
        "url": {
          "raw": "{{order-service}}/users",
          "host": [
            "{{order-service}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
